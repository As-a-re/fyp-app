# M-CARE app — environment configuration
#
# Also missing from the uploaded project (only services/api.js referenced
# these). Copy to .env and fill in.

# Backend API URL used in development builds (Expo Go / dev client).
# Defaults to http://localhost:5000/api if unset.
# - Web/iOS simulator: http://localhost:5000/api works as-is.
# - Android emulator: use http://10.0.2.2:5000/api (10.0.2.2 is the
#   emulator's alias for the host machine's localhost).
# - Physical device on the same network: use your machine's LAN IP, e.g.
#   http://192.168.1.23:5000/api
EXPO_PUBLIC_DEV_API_URL=

# Backend API URL used in production builds. This is where the deployed
# backend's URL goes once you're hosting it (e.g. the Render URL) — without
# this set, production builds fall back to the placeholder
# "https://your-production-api.com/api" in services/api.js, which is not a
# real endpoint.
EXPO_PUBLIC_PROD_API_URL=

# Agora App ID (voice/video calling — services/callManager.js /
# callService.js). Must match the same Agora project as the backend's
# AGORA_APP_ID/AGORA_APP_CERTIFICATE.
EXPO_PUBLIC_AGORA_APP_ID=
