# M-CARE app — environment configuration
#
# Also missing from the uploaded project (only services/api.js referenced
# these). Copy to .env and fill in.

# Backend API URL used in development builds (Expo Go / dev client).
# Defaults to the hosted Render API if unset.
EXPO_PUBLIC_DEV_API_URL=https://fyp-server-948u.onrender.com/api

# Backend API URL used in production builds.
EXPO_PUBLIC_PROD_API_URL=https://fyp-server-948u.onrender.com/api

# Agora App ID (voice/video calling — services/callManager.js /
# callService.js). Must match the same Agora project as the backend's
# AGORA_APP_ID/AGORA_APP_CERTIFICATE.
EXPO_PUBLIC_AGORA_APP_ID=
